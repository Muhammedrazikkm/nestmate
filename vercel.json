{
  "buildCommand": null,
  "outputDirectory": ".",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "quotecraft.nestmategroup.online"
        }
      ],
      "destination": "https://www.nestmategroup.online/#quoteCraftCard",
      "permanent": false
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "qrstudio.nestmategroup.online"
        }
      ],
      "destination": "https://www.nestmategroup.online/#qrStudioCard",
      "permanent": false
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "omnicalc.nestmategroup.online"
        }
      ],
      "destination": "https://www.nestmategroup.online/#omniCalcCard",
      "permanent": false
    }
  ]
}
